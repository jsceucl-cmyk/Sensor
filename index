<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sensor Quiz med billeder – AMU 46881 | EUC Lillebælt</title>
    <style>
        :root {
            --primary: #003366;
            --accent: #00a3e0;
            --success: #28a745;
            --danger: #dc3545;
            --warning: #ffc107;
            --bg: #0a1628;
            --card: #132337;
            --text: #e8f1f8;
            --muted: #8ba3b8;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: linear-gradient(145deg, #0a1628 0%, #0d2137 50%, #0a1628 100%);
            color: var(--text);
            min-height: 100vh;
            line-height: 1.5;
        }
        .container {
            max-width: 860px;
            margin: 0 auto;
            padding: 20px;
        }
        header {
            text-align: center;
            padding: 28px 20px 18px;
            border-bottom: 1px solid rgba(0,163,224,0.3);
            margin-bottom: 22px;
        }
        header h1 {
            font-size: 1.75rem;
            color: #fff;
            margin-bottom: 4px;
        }
        header .subtitle {
            color: var(--accent);
            font-size: 1rem;
            font-weight: 500;
        }
        header .badge {
            display: inline-block;
            background: rgba(0,163,224,0.15);
            color: var(--accent);
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.78rem;
            margin-top: 10px;
            border: 1px solid rgba(0,163,224,0.4);
        }
        #start-screen, #end-screen {
            text-align: center;
            padding: 30px 10px;
        }
        .start-card {
            background: var(--card);
            border-radius: 16px;
            padding: 36px 28px;
            border: 1px solid rgba(0,163,224,0.25);
            box-shadow: 0 10px 40px rgba(0,0,0,0.4);
        }
        .start-card h2 { font-size: 1.5rem; margin-bottom: 12px; }
        .start-card p { color: var(--muted); margin-bottom: 18px; max-width: 500px; margin-left: auto; margin-right: auto; }
        .btn {
            display: inline-block;
            background: var(--accent);
            color: #fff;
            border: none;
            padding: 13px 28px;
            font-size: 1.02rem;
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
        }
        .btn:hover { background: #0088c0; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,163,224,0.4); }
        .btn:active { transform: translateY(0); }
        .btn-secondary {
            background: transparent;
            border: 2px solid var(--accent);
            color: var(--accent);
        }
        .btn-secondary:hover { background: rgba(0,163,224,0.15); }
        .progress-bar {
            height: 6px;
            background: rgba(255,255,255,0.08);
            border-radius: 3px;
            margin-bottom: 20px;
            overflow: hidden;
        }
        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--accent), #00d4ff);
            width: 0%;
            transition: width 0.4s ease;
        }
        .progress-text {
            display: flex;
            justify-content: space-between;
            font-size: 0.85rem;
            color: var(--muted);
            margin-bottom: 6px;
        }
        .question-card {
            background: var(--card);
            border-radius: 16px;
            padding: 24px;
            border: 1px solid rgba(0,163,224,0.2);
            box-shadow: 0 8px 30px rgba(0,0,0,0.3);
            margin-bottom: 18px;
        }
        .scenario-tag {
            display: inline-block;
            background: rgba(0,163,224,0.12);
            color: var(--accent);
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 3px 10px;
            border-radius: 4px;
            margin-bottom: 10px;
        }
        .question-text {
            font-size: 1.18rem;
            font-weight: 600;
            margin-bottom: 14px;
            line-height: 1.4;
        }
        /* Visual illustration area */
        .visual {
            background: #0c1c2e;
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 16px;
            border: 1px solid rgba(0,163,224,0.15);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 160px;
            overflow: hidden;
        }
        .visual svg {
            max-width: 100%;
            height: auto;
        }
        .scenario-box {
            background: rgba(0,0,0,0.25);
            border-left: 4px solid var(--accent);
            padding: 12px 14px;
            border-radius: 0 8px 8px 0;
            margin-bottom: 18px;
            font-size: 0.92rem;
            color: #c5d8e8;
        }
        .options {
            display: flex;
            flex-direction: column;
            gap: 9px;
        }
        .option {
            background: rgba(255,255,255,0.04);
            border: 2px solid rgba(255,255,255,0.1);
            border-radius: 10px;
            padding: 12px 14px;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 12px;
            text-align: left;
        }
        .option:hover:not(.disabled) {
            border-color: var(--accent);
            background: rgba(0,163,224,0.08);
        }
        .option.selected { border-color: var(--accent); background: rgba(0,163,224,0.12); }
        .option.correct { border-color: var(--success); background: rgba(40,167,69,0.15); }
        .option.wrong { border-color: var(--danger); background: rgba(220,53,69,0.12); }
        .option.disabled { cursor: default; opacity: 0.88; }
        .option-letter {
            background: rgba(255,255,255,0.1);
            width: 26px;
            height: 26px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.82rem;
            flex-shrink: 0;
        }
        .option.correct .option-letter { background: var(--success); color: #fff; }
        .option.wrong .option-letter { background: var(--danger); color: #fff; }
        .option-icon {
            width: 36px;
            height: 36px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .option-icon svg { width: 32px; height: 32px; }
        .feedback {
            margin-top: 16px;
            padding: 14px;
            border-radius: 10px;
            display: none;
            animation: fadeIn 0.3s ease;
        }
        .feedback.show { display: block; }
        .feedback.correct { background: rgba(40,167,69,0.15); border: 1px solid rgba(40,167,69,0.4); }
        .feedback.wrong { background: rgba(220,53,69,0.12); border: 1px solid rgba(220,53,69,0.35); }
        .feedback h4 { margin-bottom: 5px; font-size: 0.98rem; }
        .feedback p { font-size: 0.9rem; color: #d0e0ec; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
        .nav-buttons {
            display: flex;
            justify-content: space-between;
            margin-top: 16px;
            gap: 12px;
        }
        .nav-buttons .btn { flex: 1; text-align: center; }
        .btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none !important; box-shadow: none !important; }
        .score-display {
            font-size: 2.4rem;
            font-weight: 700;
            color: var(--accent);
            margin: 12px 0;
        }
        .score-label { color: var(--muted); font-size: 0.92rem; }
        .result-message {
            font-size: 1.1rem;
            margin: 18px 0;
            padding: 14px;
            border-radius: 10px;
            background: rgba(0,163,224,0.1);
        }
        .hidden { display: none !important; }
        footer {
            text-align: center;
            padding: 28px 20px;
            color: var(--muted);
            font-size: 0.78rem;
            border-top: 1px solid rgba(255,255,255,0.05);
            margin-top: 36px;
        }
        /* Sensor type legend on start */
        .sensor-legend {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 12px;
            margin: 22px 0 28px;
        }
        .legend-item {
            background: rgba(0,0,0,0.25);
            border-radius: 10px;
            padding: 12px 8px;
            text-align: center;
            border: 1px solid rgba(255,255,255,0.06);
        }
        .legend-item svg { width: 48px; height: 48px; margin-bottom: 6px; }
        .legend-item span { display: block; font-size: 0.78rem; color: var(--muted); }
        @media (max-width: 600px) {
            header h1 { font-size: 1.35rem; }
            .question-text { font-size: 1.05rem; }
            .start-card { padding: 24px 16px; }
            .visual { min-height: 130px; padding: 10px; }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>Sensor Quiz</h1>
            <div class="subtitle">Mekaniske & Digitale Følere · med illustrationer</div>
            <div class="badge">AMU 46881 · Dag 2 · EUC Lillebælt</div>
        </header>

        <!-- START SCREEN -->
        <div id="start-screen">
            <div class="start-card">
                <h2>Anlæggets Sanseapparat</h2>
                <p>
                    Test din viden om sensorer i procesindustrien.
                    12 scenarier med illustrationer – vælg den rigtige føler eller løsning.
                </p>

                <div class="sensor-legend">
                    <div class="legend-item">
                        <svg viewBox="0 0 64 64" fill="none"><circle cx="32" cy="32" r="28" fill="#1a3a5c"/><rect x="22" y="18" width="20" height="28" rx="4" fill="#00a3e0"/><circle cx="32" cy="32" r="6" fill="#0a1628"/><path d="M32 14v-6M32 56v-6M14 32h-6M56 32h-6" stroke="#00d4ff" stroke-width="2"/></svg>
                        <span>Induktiv</span>
                    </div>
                    <div class="legend-item">
                        <svg viewBox="0 0 64 64" fill="none"><circle cx="32" cy="32" r="28" fill="#1a3a5c"/><rect x="14" y="22" width="16" height="20" rx="3" fill="#00a3e0"/><rect x="34" y="22" width="16" height="20" rx="3" fill="#28a745"/><path d="M30 32h4" stroke="#00d4ff" stroke-width="3" stroke-linecap="round"/></svg>
                        <span>Optisk</span>
                    </div>
                    <div class="legend-item">
                        <svg viewBox="0 0 64 64" fill="none"><circle cx="32" cy="32" r="28" fill="#1a3a5c"/><circle cx="32" cy="32" r="10" fill="#00a3e0"/><path d="M32 12c8 0 14 6 14 14M32 12c-8 0-14 6-14 14" stroke="#00d4ff" stroke-width="2" fill="none"/><path d="M32 8c12 0 20 8 20 18M32 8c-12 0-20 8-20 18" stroke="#00d4ff" stroke-width="1.5" opacity="0.5" fill="none"/></svg>
                        <span>Ultralyd</span>
                    </div>
                    <div class="legend-item">
                        <svg viewBox="0 0 64 64" fill="none"><circle cx="32" cy="32" r="28" fill="#1a3a5c"/><rect x="18" y="24" width="12" height="16" rx="2" fill="#00a3e0"/><path d="M36 28h12M36 36h12" stroke="#ff6b6b" stroke-width="3" stroke-linecap="round"/><circle cx="50" cy="32" r="6" fill="#ff6b6b"/></svg>
                        <span>Reed / Magnet</span>
                    </div>
                    <div class="legend-item">
                        <svg viewBox="0 0 64 64" fill="none"><circle cx="32" cy="32" r="28" fill="#1a3a5c"/><rect x="20" y="16" width="24" height="32" rx="4" fill="#00a3e0"/><path d="M26 28h12M26 36h12" stroke="#0a1628" stroke-width="2"/><circle cx="32" cy="48" r="3" fill="#0a1628"/></svg>
                        <span>Kapacitiv</span>
                    </div>
                    <div class="legend-item">
                        <svg viewBox="0 0 64 64" fill="none"><circle cx="32" cy="32" r="28" fill="#1a3a5c"/><rect x="16" y="26" width="32" height="12" rx="2" fill="#8ba3b8"/><path d="M28 26v-8h8v8" stroke="#ffc107" stroke-width="2" fill="#ffc107"/></svg>
                        <span>Mekanisk</span>
                    </div>
                </div>

                <button class="btn" onclick="startQuiz()">Start quizzen</button>
            </div>
        </div>

        <!-- QUIZ SCREEN -->
        <div id="quiz-screen" class="hidden">
            <div class="progress-text">
                <span id="q-counter">Spørgsmål 1 af 12</span>
                <span id="score-live">Score: 0</span>
            </div>
            <div class="progress-bar">
                <div class="progress-fill" id="progress"></div>
            </div>

            <div class="question-card">
                <div class="scenario-tag" id="scenario-tag">Scenarie</div>
                <div class="question-text" id="question-text"></div>
                <div class="visual" id="visual"></div>
                <div class="scenario-box" id="scenario-box"></div>
                <div class="options" id="options"></div>
                <div class="feedback" id="feedback">
                    <h4 id="feedback-title"></h4>
                    <p id="feedback-text"></p>
                </div>
            </div>

            <div class="nav-buttons">
                <button class="btn btn-secondary" id="btn-next" onclick="nextQuestion()" disabled>Næste spørgsmål →</button>
            </div>
        </div>

        <!-- END SCREEN -->
        <div id="end-screen" class="hidden">
            <div class="start-card">
                <h2>Quiz færdig!</h2>
                <div class="score-label">Din score</div>
                <div class="score-display" id="final-score">0 / 12</div>
                <div class="result-message" id="result-message"></div>
                <p style="color: var(--muted); margin-bottom: 22px; font-size: 0.9rem;">
                    Du er nu klar til at diskutere sensorvalg og fejlfinding med kolleger og teknikere.
                </p>
                <button class="btn" onclick="restartQuiz()">Prøv igen</button>
            </div>
        </div>

        <footer>
            Baseret på undervisningsmateriale AMU 46881 · Mekaniske og Digitale Følere<br>
            EUC Lillebælt · Operatør vedligehold
        </footer>
    </div>

    <script>
        // ========== SVG ILLUSTRATIONS ==========
        const svgs = {
            conveyor: `
            <svg viewBox="0 0 400 160" xmlns="http://www.w3.org/2000/svg">
                <!-- Conveyor belt -->
                <rect x="20" y="90" width="360" height="18" rx="4" fill="#2a4a6a"/>
