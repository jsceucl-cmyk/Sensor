                <line x1="281" y1="55" x2="281" y2="90" stroke="#00d4ff" stroke-width="2" stroke-dasharray="4 3"/>
                <text x="200" y="140" text-anchor="middle" fill="#8ba3b8" font-size="12">Transportbånd med papkasser</text>
            </svg>`,

            robot: `
            <svg viewBox="0 0 400 160" xmlns="http://www.w3.org/2000/svg">
                <!-- Robot arm base -->
                <rect x="40" y="100" width="50" height="30" rx="4" fill="#3a5a7a"/>
                <!-- Arm -->
                <rect x="55" y="40" width="16" height="70" rx="3" fill="#4a6a8a"/>
                <rect x="55" y="40" width="80" height="14" rx="3" fill="#4a6a8a"/>
