                <circle cx="50" cy="99" r="10" fill="#3a5a7a"/><circle cx="50" cy="99" r="4" fill="#0a1628"/>
                <circle cx="350" cy="99" r="10" fill="#3a5a7a"/><circle cx="350" cy="99" r="4" fill="#0a1628"/>
                <!-- Boxes -->
                <rect x="80" y="50" width="55" height="40" rx="3" fill="#c4a35a" stroke="#8b7355" stroke-width="1"/>
