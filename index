                <path d="M170 50v-8M170 90v8M150 70h-8M190 70h8" stroke="#00d4ff" stroke-width="2"/>
                <text x="200" y="150" text-anchor="middle" fill="#8ba3b8" font-size="12">Robotarm + metalpalle + induktiv føler</text>
            </svg>`,

            reduction: `
            <svg viewBox="0 0 400 160" xmlns="http://www.w3.org/2000/svg">
                <!-- Sensor -->
                <circle cx="100" cy="80" r="28" fill="#00a3e0"/>
                <circle cx="100" cy="80" r="12" fill="#0a1628"/>
                <!-- Steel target -->
                <rect x="180" y="50" width="50" height="60" rx="4" fill="#8a9aaa" stroke="#6a7a8a" stroke-width="2"/>
